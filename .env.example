# Etsy app credentials — from etsy.com/developers/your-apps
# The "Keystring" is your OAuth client_id. PKCE means the shared secret is
# never sent during the OAuth code exchange itself, but Etsy still requires
# it in the x-api-key header ("keystring:secret") on every other API call.
ETSY_KEYSTRING=your_app_keystring
ETSY_SHARED_SECRET=your_app_shared_secret

# Must match a callback URL registered on the app, character for character.
ETSY_REDIRECT_URI=http://localhost:3003/oauth/callback
